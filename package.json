{
  "name": "mac-it-run-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "env": "node --env-file-if-exists=.env.local scripts/public-env.mjs",
    "postinstall": "npm run env",
    "start": "npm run env && ng serve",
    "build": "npm run env && ng build",
    "build:vercel": "npm run build && rm -f dist/macItRun-web/browser/index.csr.html",
    "watch": "ng build --watch --configuration development",
    "test": "npm run env && ng test",
    "lint": "ng lint",
    "test:ci": "npm run env && ng test --watch=false --browsers=ChromeHeadless",
    "test:db": "node --test 'supabase/tests/*.test.mjs'",
    "serve:ssr": "node dist/macItRun-web/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~20.3.0",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-server": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/ssr": "^20.3.42",
    "@jsverse/transloco": "^8.4.0",
    "@primeuix/themes": "^3.1.0",
    "@supabase/supabase-js": "^2.118.0",
    "express": "^5.1.0",
    "primeicons": "^8.0.2",
    "primeng": "^20.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.42",
    "@angular/cli": "^20.3.42",
    "@angular/compiler-cli": "^20.3.0",
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "angular-eslint": "20.7.0",
    "eslint": "^9.39.1",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.4"
  },
  "engines": {
    "node": "22.x"
  }
}
