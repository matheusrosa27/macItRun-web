{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mac-it-run.vercel.app/schemas/profile.schema.json",
  "title": "macItRun setup profile",
  "description": "Arquivo .macitrun-profile, versão 1. Só configuração: nada que execute código, aponte para arquivos ou baixe algo. O arquivo inteiro tem no máximo 16 KB (conferido fora do schema). Fonte única das regras do site e do app (GameProfile.validate() em Sources/MacItRunCore/Profiles.swift).",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "profile"],
  "properties": {
    "format": { "const": "macitrun-profile" },
    "version": { "const": 1 },
    "profile": { "$ref": "#/$defs/profile" },
    "testedOn": { "$ref": "#/$defs/testedOn" }
  },
  "$defs": {
    "shortLine": {
      "description": "Até 256 caracteres, sem quebra de linha.",
      "type": "string",
      "maxLength": 256,
      "pattern": "^[^\\n\\r\\u000b\\u000c\\u0085\\u2028\\u2029]*$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "executables"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S" },
        "executables": {
          "description": "Só o nome do arquivo .exe, sem pasta. O steamwebhelper.exe é configurado pelo próprio macItRun.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(?![Ss][Tt][Ee][Aa][Mm][Ww][Ee][Bb][Hh][Ee][Ll][Pp][Ee][Rr]\\.[Ee][Xx][Ee]$)[A-Za-z0-9 _.()+-]{1,96}\\.[Ee][Xx][Ee]$"
          }
        },
        "graphics": { "enum": ["dxmt", "dxvk", "wine"] },
        "windowsVersion": { "enum": ["win11", "win10", "win81", "win8", "win7", "winxp"] },
        "dllOverrides": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9_.-]{1,64}$" },
          "additionalProperties": {
            "enum": ["native", "builtin", "native,builtin", "builtin,native", "disabled", ""]
          }
        },
        "environment": {
          "description": "Só variáveis das camadas gráficas. WINEMSYNC e WINEESYNC valem para a garrafa inteira; nomes terminados em PATH, FILE ou DIR apontariam para arquivos.",
          "type": "object",
          "propertyNames": {
            "pattern": "^(?!WINEMSYNC$|WINEESYNC$)(?=DXVK_|DXMT_|MVK_CONFIG_|MTL_HUD_)(?![A-Z0-9_]*(?:PATH|FILE|DIR)$)[A-Z0-9_]{1,64}$"
          },
          "additionalProperties": { "$ref": "#/$defs/shortLine" }
        },
        "arguments": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/shortLine" }
        },
        "notes": { "type": "string", "maxLength": 2000 }
      }
    },
    "testedOn": {
      "description": "Preenchido pelo app; o site não deixa editar.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mac": { "$ref": "#/$defs/testedValue" },
        "macOS": { "$ref": "#/$defs/testedValue" },
        "runtime": { "$ref": "#/$defs/testedValue" },
        "app": { "$ref": "#/$defs/testedValue" }
      }
    },
    "testedValue": { "type": "string", "pattern": "^[A-Za-z0-9 ._,()+-]{1,64}$" }
  }
}
