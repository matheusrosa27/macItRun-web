/* Tipos do código que roda fora do Angular: o pacote do perfil e a API (Edge Function). */
{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    // Node roda o TypeScript só apagando os tipos: nada de enum nem propriedade no construtor.
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["packages/**/*.ts", "supabase/functions/**/*.ts"],
  // index.ts só roda no Deno do Supabase.
  "exclude": ["supabase/functions/**/index.ts"]
}
